# Database (Docker default below; Windows project-local Postgres uses port 5433 + user fv)
# DATABASE_URL="postgresql://fv@localhost:5433/fruits_vegs?schema=public"
DATABASE_URL="postgresql://fv:fv_local@localhost:5432/fruits_vegs?schema=public"

# Redis (optional locally; queues fall back to in-process if unavailable)
REDIS_URL="redis://localhost:6379"

# API
API_PORT=4000
API_URL="http://localhost:4000"
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars!!"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars!"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="7d"
UPLOAD_DIR="./uploads"
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"

# Web / Admin
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_DEFAULT_LOCALE="en"
# Stripe (test)
STRIPE_SECRET_KEY="sk_test_placeholder"
STRIPE_WEBHOOK_SECRET="whsec_placeholder"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_placeholder"

# Company defaults
COMPANY_NAME="Fresh Harvest UAE"
COMPANY_TRN="100000000000003"
VAT_RATE="5"
CURRENCY="AED"
TZ="Asia/Dubai"
