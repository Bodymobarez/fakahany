{
  "expo": {
    "name": "Fresh Harvest Driver",
    "slug": "fv-driver",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "fv-driver",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0f172a"
      }
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "API_URL": "http://localhost:4000",
      "eas": {
        "projectId": "fv-driver-local"
      }
    }
  }
}
