{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nabtio",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-12-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "nabtio"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "nabtio.adsolutions-eg.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "NEXTJS_ENV": "production",
    // Avoid dynamic require of middleware-manifest.json on Workers (causes 500 on all routes).
    // OpenNext still runs next-intl middleware via its separate middleware bundle.
    "NEXT_PRIVATE_MINIMAL_MODE": "1",
    // Public API (Cloudflare tunnel → local Express + Postgres). Update when the tunnel URL changes.
    "NEXT_PUBLIC_API_URL": "https://bowling-translated-ronald-dos.trycloudflare.com",
    "NEXT_PUBLIC_ADMIN_URL": "https://admin.nabtio.adsolutions-eg.com"
  }
}
